---
source: crates/oxcruise_report/tests/reporters.rs
expression: "rendered(\"dot\", &plain())"
---
digraph oxcruise {
  rankdir=LR;
  node [shape=box, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "fs" [shape=ellipse];
  "node_modules/fsevents/index.js" [shape=component];
  "node_modules/left-pad/index.js" [shape=component, color=red, fontcolor=red];
  "node_modules/lodash/index.js" [shape=component];
  "node_modules/react/index.js" [shape=component, color=red, fontcolor=red];
  "node_modules/vitest/index.js" [shape=component, color=red, fontcolor=red];
  "packages/app/src/cjs-thing.js" [shape=box];
  "packages/app/src/cycle-a.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/cycle-b.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/helpers.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/index.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/internal/secret.ts" [shape=box];
  "packages/app/src/lazy.ts" [shape=box];
  "packages/app/src/orphan.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/suppressed.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/thing.test.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/uses-test.ts" [shape=box, color=red, fontcolor=red];
  "packages/app/src/util.ts" [shape=box, color=red, fontcolor=red];
  "packages/lib/src/index.ts" [shape=box, color=red, fontcolor=red];
  "packages/lib/src/inner.ts" [shape=box];
  "sys" [shape=ellipse, color=red, fontcolor=red];
  "packages/app/src/cycle-a.ts" -> "packages/app/src/cycle-b.ts" [color=red, label="no-circular"];
  "packages/app/src/cycle-b.ts" -> "packages/app/src/cycle-a.ts" [color=red, label="no-circular"];
  "packages/app/src/helpers.ts" -> "packages/app/src/util.ts" [style=dashed, color=red, label="no-circular"];
  "packages/app/src/index.ts" -> "./missing" [color=red, label="no-unresolvable"];
  "packages/app/src/index.ts" -> "fs";
  "packages/app/src/index.ts" -> "node_modules/fsevents/index.js" [color=orange, label="optional-deps-used"];
  "packages/app/src/index.ts" -> "node_modules/left-pad/index.js" [color=red, label="no-non-package-json"];
  "packages/app/src/index.ts" -> "node_modules/lodash/index.js";
  "packages/app/src/index.ts" -> "node_modules/react/index.js" [color=orange, label="peer-deps-used"];
  "packages/app/src/index.ts" -> "node_modules/vitest/index.js" [color=red, label="no-dev-deps-in-prod"];
  "packages/app/src/index.ts" -> "packages/app/src/cjs-thing.js";
  "packages/app/src/index.ts" -> "packages/app/src/cycle-a.ts";
  "packages/app/src/index.ts" -> "packages/app/src/helpers.ts";
  "packages/app/src/index.ts" -> "packages/app/src/internal/secret.ts";
  "packages/app/src/index.ts" -> "packages/app/src/lazy.ts" [style=dotted];
  "packages/app/src/index.ts" -> "packages/app/src/util.ts";
  "packages/app/src/index.ts" -> "packages/lib/src/index.ts";
  "packages/app/src/index.ts" -> "sys" [color=orange, label="no-deprecated-core"];
  "packages/app/src/suppressed.ts" -> "./also-nope" [color=red, label="no-unresolvable"];
  "packages/app/src/suppressed.ts" -> "./nope";
  "packages/app/src/uses-test.ts" -> "packages/app/src/thing.test.ts" [color=red, label="not-to-test"];
  "packages/app/src/util.ts" -> "packages/app/src/helpers.ts" [color=red, label="no-circular"];
  "packages/lib/src/index.ts" -> "@app/helpers" [color=red, label="no-unresolvable"];
  "packages/lib/src/index.ts" -> "packages/lib/src/inner.ts";
}
