{
  "rules": {
    "no-circular": "error",
    "no-orphans": ["warn", {
      "ignore": [
        { "regex": "(^|/)[.][^/]+[.](js|cjs|mjs|ts|cts|mts|json)$" },
        { "regex": "[.]d[.]ts$" },
        { "regex": "(^|/)tsconfig[.]json$" },
        { "regex": "(^|/)(babel|webpack)[.]config[.](js|cjs|mjs|ts|cts|mts|json)$" }
      ]
    }],
    "no-deprecated-core": "warn",
    "no-deprecated-npm": "warn",
    "no-non-package-json": "error",
    "no-unresolvable": "error",
    "no-duplicate-dep-types": "warn",
    "not-to-test": "error",
    "not-to-spec": "error",
    "no-dev-deps-in-prod": "error",
    "optional-deps-used": "info",
    "peer-deps-used": "warn"
  }
}
