---
source: crates/oxcruise_config/tests/depcruise_import.rs
expression: cfg
---
{
  "$schema": null,
  "extends": [],
  "entries": [],
  "ignorePatterns": [
    "dist*",
    "**/*.stories.tsx"
  ],
  "doNotFollow": [
    "**/*node_modules*",
    "**/*.generated.ts"
  ],
  "categories": {
    "suspicious": "error"
  },
  "rules": {},
  "forbid": [
    {
      "name": "feature-isolation",
      "message": "features must not import each other",
      "severity": "error",
      "from": "src/features/{c1}/**",
      "to": [
        "src/features/**",
        "!src/features/{c1}/**"
      ]
    },
    {
      "name": "no-spec-in-src",
      "message": null,
      "severity": "error",
      "from": [
        "src*",
        "!**/*.spec.ts"
      ],
      "to": "**/*.spec.ts"
    },
    {
      "name": "no-lazy-node-in-web",
      "message": null,
      "severity": "error",
      "from": "**/web/**",
      "to": {
        "path": "{fs,path}",
        "kind": null,
        "typeOnly": null,
        "dynamic": true,
        "relation": null,
        "reachable": null
      }
    },
    {
      "name": "no-unresolvable",
      "message": null,
      "severity": "error",
      "from": null,
      "to": {
        "path": null,
        "kind": "unresolved",
        "typeOnly": null,
        "dynamic": null,
        "relation": null,
        "reachable": null
      }
    },
    {
      "name": "ui-never-reaches-db",
      "message": null,
      "severity": "error",
      "from": "src/ui/**",
      "to": {
        "path": "src/db/**",
        "kind": null,
        "typeOnly": null,
        "dynamic": null,
        "relation": null,
        "reachable": true
      }
    }
  ],
  "overrides": [],
  "resolve": {
    "tsconfig": "tsconfig.app.json",
    "conditions": [
      "source"
    ],
    "alias": {}
  },
  "calls": [
    "need"
  ],
  "jsPlugins": []
}
