// Migrated from .dependency-cruiser.json by `oxcruise --migrate`.
// TODO: rule `no-circular` was dropped: `to.circular` is not supported (the built-in rule `no-circular` covers this)
// TODO: rule `needs-license` was dropped: `to.license` is not supported (write a JS plugin rule for it)
// TODO: rule `not-in-prod`: severity `info` does not exist in oxcruise and was mapped to `warn`
// TODO: `options.webpackConfig` is not supported; use `resolve.alias` for webpack aliases
import { defineConfig } from "oxcruise";

export default defineConfig({
  "doNotFollow": [
    "**/*node_modules*"
  ],
  "forbid": [
    {
      "name": "feature-isolation",
      "message": "features stay apart",
      "severity": "error",
      "from": "src/features/{c1}/**",
      "to": [
        "src/features/**",
        "!src/features/{c1}/**"
      ]
    },
    {
      "name": "not-in-prod",
      "severity": "warn",
      "from": "src*",
      "to": "**/*.spec.ts"
    }
  ]
});
