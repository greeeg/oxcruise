{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OxcruiseConfig",
  "description": "The oxcruise configuration file.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": ["string", "null"],
      "default": null
    },
    "calls": {
      "description": "Callee names whose first string argument is a dependency, e.g. `jest.mock`.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "description": "Switch groups of built-in rules on or off. Default: `correctness: error, suspicious: warn`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Level"
      },
      "default": {}
    },
    "doNotFollow": {
      "description": "Matching modules stay in the graph, but their imports are not parsed.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "description": "Files, directories or globs to start from. Default: `[\".\"]`.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "extends": {
      "description": "Paths to other config files, merged underneath this one.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "forbid": {
      "description": "Ad-hoc forbidden dependencies.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ForbidRule"
      }
    },
    "ignorePatterns": {
      "description": "Modules matching these globs are not part of the graph. `.gitignore` is always honoured.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "jsPlugins": {
      "description": "JS/TS plugin modules (paths or package names).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/JsPlugin"
      }
    },
    "overrides": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Override"
      }
    },
    "resolve": {
      "$ref": "#/$defs/ResolveSection",
      "default": {
        "alias": {},
        "conditions": [],
        "tsconfig": null
      }
    },
    "rules": {
      "description": "Built-in and plugin rules by name. A rule listed here wins over its category.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RuleEntry"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AliasedPlugin": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Rules are named `<name>/<rule>`, instead of using the plugin's own `meta.name`.",
          "type": "string"
        },
        "specifier": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["name", "specifier"]
    },
    "ForbidRule": {
      "description": "A forbidden dependency: an import from `from` to `to` is a violation.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Globs of the importing module. `{name}` captures a path segment for use in `to`.",
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "description": "Why the dependency is forbidden; shown instead of the generic message.",
          "type": ["string", "null"]
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Level",
          "default": "error"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToSpec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["name"]
    },
    "JsPlugin": {
      "description": "A JS/TS plugin: a path or package name, or the same with the name its rules are registered under.",
      "anyOf": [
        {
          "description": "`\"./tools/acme.ts\"` or `\"acme\"` (resolved as `oxcruise-plugin-acme`, then `acme`).",
          "type": "string"
        },
        {
          "$ref": "#/$defs/AliasedPlugin"
        }
      ]
    },
    "Kind": {
      "description": "What a dependency points to.",
      "oneOf": [
        {
          "description": "A file of the project.",
          "type": "string",
          "const": "local"
        },
        {
          "description": "A file inside `node_modules`.",
          "type": "string",
          "const": "package"
        },
        {
          "description": "A Node.js built-in module.",
          "type": "string",
          "const": "builtin"
        },
        {
          "description": "An import that could not be resolved.",
          "type": "string",
          "const": "unresolved"
        }
      ]
    },
    "Level": {
      "description": "Severity of a rule. `off` disables it.",
      "type": "string",
      "enum": ["off", "warn", "error"]
    },
    "OneOrMany": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "OneOrMany2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Kind"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Kind"
          }
        }
      ]
    },
    "OneOrMany3": {
      "anyOf": [
        {
          "$ref": "#/$defs/Relation"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        }
      ]
    },
    "Override": {
      "type": "object",
      "properties": {
        "files": {
          "description": "Globs of the importing module this override applies to.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RuleEntry"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": ["files"]
    },
    "Relation": {
      "description": "How two modules relate, for the `relation` condition.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["same-package", "cross-package"]
        },
        {
          "description": "`to` is in the same folder as `from`.",
          "type": "string",
          "const": "same-folder"
        },
        {
          "description": "`to` is below the folder of `from`.",
          "type": "string",
          "const": "descendant-of-from"
        },
        {
          "description": "`to` is below the parent folder of `from`.",
          "type": "string",
          "const": "descendant-of-from-parent"
        },
        {
          "description": "`to` is in a sibling folder of `from`'s folder.",
          "type": "string",
          "const": "sibling"
        }
      ]
    },
    "ResolveSection": {
      "type": "object",
      "properties": {
        "alias": {
          "description": "Aliases: `{ \"~\": \"./src\" }`.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/OneOrMany"
          },
          "default": {}
        },
        "conditions": {
          "description": "Export/import condition names tried before `import`/`require`, `node` and `default`,\ne.g. `[\"source\"]` to resolve workspace packages to their source.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "tsconfig": {
          "description": "One tsconfig used for every file. Default: the nearest tsconfig of each file.",
          "type": ["string", "null"],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "RuleEntry": {
      "description": "A rule entry: `\"error\"`, or `[\"error\", { ...options }]`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Level"
        },
        {
          "type": "array",
          "items": true
        }
      ]
    },
    "ToCondition": {
      "description": "Conditions on the dependency and the module it points to.",
      "type": "object",
      "properties": {
        "dynamic": {
          "description": "The dependency is a dynamic `import()`.",
          "type": ["boolean", "null"],
          "default": null
        },
        "kind": {
          "description": "What the dependency points to; any of these.",
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reachable": {
          "description": "`to` is reachable from `from` through other modules.",
          "type": ["boolean", "null"],
          "default": null
        },
        "relation": {
          "description": "How `to` relates to `from`; any of these.",
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "typeOnly": {
          "description": "The dependency is `import type` / `export type` only.",
          "type": ["boolean", "null"],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ToSpec": {
      "anyOf": [
        {
          "description": "Globs the dependency's target must match.",
          "$ref": "#/$defs/OneOrMany"
        },
        {
          "$ref": "#/$defs/ToCondition"
        }
      ]
    }
  }
}
